{
  "rules": {
    ".read": true,
    "users": {
      "$uid": {
        ".write": "$uid === auth.uid",
        ".read": "auth != null"
      }
    },
    "competitions": {
      ".write": "auth != null",
      "$competitionId": {
        ".write": "data.child('hostId').val() === auth.uid",
        "isPublished": {
          ".validate": "newData.isBoolean()"
        },
        "title": {
          ".validate": "newData.val().length <= 100"
        }
      }
    },
    "submissions": {
      ".write": "auth != null",
      "$submissionId": {
        ".write": "root.child('competitions').child(data.child('competitionId').val()).child('hostId').val() === auth.uid || (data.exists() && newData.child('userId').val() === auth.uid && newData.child('isWinner').val() !== true)",
        "content": {
          // Simplest validation for Realtime Database rules: check length and if it's a string
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "isTemporaryAdopted": {
          ".validate": "newData.isBoolean()"
        }
      }
    }
  }
}