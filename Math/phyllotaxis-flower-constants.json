{
  "title": "Phyllotaxis Flower Generation Parameters",
  "description": "Golden angle-based flower/petal generation constants for visual art",
  "version": "1.0",
  "author": "bonsai/qwen3.6-plus",
  "contact": "onsen.bonsai@gmail.com",
  "date": "2026-04-13",
  
  "constants": {
    "PHI": 1.618033988749895,
    "PHI_formula": "(1 + sqrt(5)) / 2",
    "GOLDEN_ANGLE_DEG": 137.508,
    "GOLDEN_ANGLE_RAD": 2.399963229728653,
    "GOLDEN_ANGLE_formula": "360 / PHI^2",
    "SQRT5": 2.23606797749979
  },

  "flower_generation": {
    "point_count": 150,
    "scale_factor": 10,
    "center_x": 250,
    "center_y": 240,
    "max_radius": 198,
    "dot_size_base": 2,
    "dot_size_growth": 0.5,
    "dot_size_formula": "2 + sqrt(i) * 0.5",
    "hue_base": 40,
    "hue_range": 20,
    "hue_formula": "40 + (i * 3) % 20",
    "saturation": 70,
    "lightness_base": 55,
    "lightness_growth": 0.3,
    "opacity_min": 0.6,
    "opacity_max": 1.0,
    "opacity_formula": "0.6 + min(i / count, 0.4)"
  },

  "spiral_arms": {
    "count": 5,
    "points_per_arm": 20,
    "growth_rate": 5,
    "offset_base": 3,
    "radius_formula": "scale * sqrt(i * 5 + s * 3)",
    "stroke_width": 1.5,
    "stroke_opacity": 0.3
  },

  "coordinate_calculation": {
    "angle_deg_formula": "i * GOLDEN_ANGLE_DEG",
    "angle_rad_formula": "angleDeg * PI / 180",
    "radius_formula": "scale * sqrt(i)",
    "x_formula": "cx + r * cos(angleRad)",
    "y_formula": "cy + r * sin(angleRad)"
  },

  "color_palette": {
    "theme": "warm_gold",
    "colors": [
      { "name": "pale_gold", "hsl": "hsl(40, 70%, 60%)", "hex": "#f5e6a3" },
      { "name": "goldenrod", "hsl": "hsl(43, 70%, 58%)", "hex": "#e8d580" },
      { "name": "amber", "hsl": "hsl(46, 70%, 56%)", "hex": "#dfc870" },
      { "name": "deep_gold", "hsl": "hsl(49, 70%, 54%)", "hex": "#d4b85a" },
      { "name": "bronze", "hsl": "hsl(35, 70%, 52%)", "hex": "#c9a84c" }
    ],
    "background": {
      "hsl": "hsl(230, 40%, 8%)",
      "hex": "#0a0a1a"
    }
  },

  "prompt_for_generation": "Generate a phyllotaxis flower using the golden angle 137.508°. Place 150 dots in a spiral pattern where each dot i is positioned at angle = i * 137.508° and radius = 10 * sqrt(i). Use warm gold color palette with varying dot sizes (2 + sqrt(i)*0.5). Draw 5 golden spiral arms as parastichies. The result should resemble a sunflower seed pattern or daisy center, mathematically precise with the golden ratio.",

  "related_papers": [
    "golden-ratio-proportion-theory.md",
    "prime-fibonacci-discovery.md"
  ]
}
